/resources/rice/
# everything under results/ is ignored EXCEPT the serialized comparison fixtures, which are test *inputs*
# (test_scenarios cannot run without them). Each level must be re-included explicitly: git does not descend into an
# excluded directory, so a negation alone cannot resurrect a file inside one.
/results/*
!/results/comparisons/
/results/comparisons/*
!/results/comparisons/serialized/
/results/comparisons/serialized/*
!/results/comparisons/serialized/*.json
/docs/_build/
/docs/jupyter_execute/
/slurm/logs/
.DS_Store
.idea/
.ipynb_checkpoints/
/testing/tmp/
__pycache__/
/testing/scratch/
/example_workflows/inference/results/
.RData
.Rhistory

# coverage artifacts
.coverage
coverage.xml
